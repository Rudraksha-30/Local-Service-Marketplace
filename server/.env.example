PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/service-marketplace
# At least 16 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# One or more client addresses, comma separated, no trailing slash
CLIENT_URL=http://localhost:5173
# Max login/register requests per address per 15 minutes
AUTH_RATE_LIMIT=100
